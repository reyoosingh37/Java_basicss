	<h1>Update Employee</h1>

	<form action="update" method="get">
		<input type="text" name="id" value="1" readonly><br><br>
		<input type="text" name="name" value="megha" required><br><br>
		<input type="email" name="email" value="megha@gmail.com" required><br><br>
		<input type="tel" name="phone" value="9876543210" required><br><br>
		<input type="text" name="department" value="cse" required><br><br>
		<input type="text" name="position" value="professor" required><br><br>
		<input type="number" name="salary" value="800000.0" required><br><br>
		<input type="text" name="address" value="xyz" required><br><br>
		<input type="text" name="dateOfJoining" value="aug" required><br><br>
		<button type="submit">Update</button>
	</form>

